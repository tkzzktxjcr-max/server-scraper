{
  "name": "scraper-server",
  "version": "1.0.0",
  "description": "Browser automation scraper server that writes to Appwrite Database",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "appwrite": "^16.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.1",
    "node-cron": "^3.0.3",
    "puppeteer": "^23.3.0",
    "puppeteer-core": "^23.3.0",
    "typescript": "^5.5.3",
    "uuid": "^10.0.0",
    "winston": "^3.14.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.5.5",
    "@types/uuid": "^10.0.0",
    "tsx": "^4.19.1"
  },
  "engines": {
    "node": ">=18.0.0"
  }
